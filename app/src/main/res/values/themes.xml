<resources>
    <style name="SahlTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/emerald</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/emerald_dark</item>
    </style>
    <style name="Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Clear" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
