<resources>
    <style name="SahlTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/emerald</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/emerald_dark</item>
    </style>
    <style name="Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Clear" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Popup" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
