<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sahl Union: shared with every Sahl app signed with the same key -->
    <permission android:name="com.sahl.permission.UNION" android:label="Sahl apps" android:protectionLevel="signature" />
    <uses-permission android:name="com.sahl.permission.UNION" />
    <queries>
        <package android:name="com.aly.sahlpdf" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.sahl.home" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.aly.sahlsync" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.camera" />
        <provider android:authorities="com.sahl.contacts.union" />
        <provider android:authorities="com.sahl.phone.union" />
        <provider android:authorities="com.sahl.messages.union" />
        <provider android:authorities="com.sahl.files.union" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.messages" />
        <package android:name="com.sahl.files" />
    </queries>
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.sahl.home" />
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.messages" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.sahl.qibla" />
        <package android:name="com.sahl.files" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.camera" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.sahl.timer" />
        <package android:name="com.aly.sahlsync" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
    <application android:name=".SahlApp" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true" android:theme="@style/SahlTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" /></intent-filter>
        </activity>
        <activity android:name=".ActionActivity" android:exported="false" android:theme="@style/Invisible"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <service android:name=".ScreenTile" android:exported="true" android:label="@string/screen_t" android:icon="@drawable/ic_screen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".VolumeTile" android:exported="true" android:label="@string/volume_t" android:icon="@drawable/ic_volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TouchTile" android:exported="true" android:label="@string/touch_t" android:icon="@drawable/ic_touch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TimerTile" android:exported="true" android:label="@string/timer_t" android:icon="@drawable/ic_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".VolumeLockService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps chosen volume levels locked until the user unlocks" />
        </service>
        <service android:name=".TouchLockService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Full-screen overlay that blocks touches until the user unlocks" />
        </service>
        <service android:name=".TimerService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Floating stopwatch/countdown bubble over other apps" />
        </service>
        <service android:name=".FlashTile" android:exported="true" android:label="@string/flash_t" android:icon="@drawable/ic_flash"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".DimTile" android:exported="true" android:label="@string/dim_t" android:icon="@drawable/ic_dim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".SoundTile" android:exported="true" android:label="@string/sound_t" android:icon="@drawable/ic_sound"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".ScanTile" android:exported="true" android:label="@string/scan_t" android:icon="@drawable/ic_scan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".DimService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Darkening layer over the screen until the user turns it off" />
        </service>
        <activity android:name=".ScanActivity" android:exported="false" android:label="@string/scan_t" />
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity" android:screenOrientation="fullSensor" tools:replace="screenOrientation" />
        <activity android:name=".WifiActivity" android:exported="false" android:label="@string/wifi_t" />
        <activity android:name=".PickPhotosActivity" android:exported="false" android:theme="@style/Clear" />
        <activity android:name=".LinkActivity" android:exported="false" android:label="@string/link_t" />
        <activity android:name=".LinkPopupActivity" android:exported="true" android:label="@string/check_link"
            android:theme="@style/Popup" android:excludeFromRecents="true" android:taskAffinity="" android:documentLaunchMode="always">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter android:label="@string/share_clean_link">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".PhotoActivity" android:exported="true" android:label="@string/share_clean_photo">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name=".SaveActivity" android:exported="true" android:label="@string/share_save" android:theme="@style/Clear">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <service android:name=".CustomTabsService" android:exported="true">
            <intent-filter><action android:name="android.support.customtabs.action.CustomTabsService" /></intent-filter>
        </service>
        <activity android:name=".SpeedActivity" android:exported="false" android:label="@string/speed_t" />
        <activity android:name=".DataActivity" android:exported="false" android:label="@string/data_t" />
        <activity android:name=".LauncherActivity" android:exported="false" android:label="@string/launcher_t" />
        <activity android:name=".ScreenLightActivity" android:exported="false" android:label="@string/light_t"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <activity android:name=".WifiPassActivity" android:exported="false" android:label="@string/wpass_t" />
        <activity android:name=".DeepLinkActivity" android:exported="false" android:label="@string/deeplink_t" />
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku"
            android:multiprocess="false" android:enabled="true" android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".FreezerActivity" android:exported="false" android:label="@string/fr_t" />
        <activity android:name=".AppPickerActivity" android:exported="false" android:label="@string/fr_add" />
        <activity android:name=".DebloatActivity" android:exported="false" android:label="@string/db_t" />
        <activity android:name=".FreezeLaunchActivity" android:exported="true" android:theme="@style/Invisible"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <service android:name=".FreezeTile" android:exported="true" android:label="@string/fr_t" android:icon="@drawable/ic_freeze"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".AutoFreezeService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Refreezes apps the user chose after the screen turns off" />
        </service>
        <!-- Sahl Search: its own home-screen icon -->
        <activity android:name=".SearchActivity" android:exported="true" android:label="@string/s_title"
            android:icon="@mipmap/ic_search_launcher" android:taskAffinity="com.sahl.tools.search" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".SearchTile" android:exported="true" android:label="@string/s_title" android:icon="@drawable/ic_search"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity android:name=".CrashActivity" android:exported="false" android:process=":crash" />
        <activity android:name=".CallGuardActivity" android:exported="true" android:label="@string/cg_t"
            android:permission="com.sahl.permission.UNION">
            <!-- Sahl Union: Sahl Phone opens Call Guard settings from here -->
            <intent-filter>
                <action android:name="com.sahl.tools.action.CALL_GUARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider android:name=".UnionProvider" android:authorities="com.sahl.tools.union" android:exported="true"
            android:readPermission="com.sahl.permission.UNION" android:writePermission="com.sahl.permission.UNION" />
        <service android:name=".SahlCallScreening" android:exported="true" android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>
        <receiver android:name=".UpdateCheckReceiver" android:exported="false" />
        <activity android:name=".FocusActivity" android:exported="false" android:label="@string/fo_t" android:launchMode="singleTop" />
        <receiver android:name=".FocusAlarm" android:exported="false" />
        <service android:name=".SahlSpellChecker" android:exported="true" android:label="@string/pr_t"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter><action android:name="android.service.textservice.SpellCheckerService" /></intent-filter>
            <meta-data android:name="android.view.textservice.scs" android:resource="@xml/spellchecker" />
        </service>
        <activity android:name=".ProofActivity" android:exported="true" android:label="@string/pr_t" />
        <activity android:name=".ProofPopupActivity" android:exported="true" android:label="@string/pr_action"
            android:theme="@style/Popup" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
